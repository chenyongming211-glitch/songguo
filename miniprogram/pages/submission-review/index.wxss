.submission-page {
  padding-top: 24rpx;
}

.submission-hero {
  padding: 34rpx;
  margin-bottom: 24rpx;
  background:
    radial-gradient(circle at 90% 8%, rgba(20, 184, 166, 0.18), transparent 32%),
    linear-gradient(145deg, rgba(255, 255, 255, 0.98), rgba(255, 248, 232, 0.94));
}

.submission-input {
  min-height: 250rpx;
}

.section-block {
  margin-top: 20rpx;
}

.item-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.submission-item {
  padding: 26rpx;
}

.item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.item-index {
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 900;
}

.result-chip {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 900;
}

.result-correct {
  background: rgba(220, 252, 231, 0.94);
  color: #15803d;
}

.result-wrong {
  background: rgba(255, 228, 230, 0.94);
  color: #be123c;
}

.result-pending {
  background: rgba(254, 243, 199, 0.96);
  color: #a16207;
}

.item-question {
  display: block;
  color: #1c1917;
  font-size: 29rpx;
  font-weight: 850;
  line-height: 1.55;
  word-break: break-word;
}

.item-answer,
.item-type {
  display: block;
  margin-top: 12rpx;
  color: #5f5a50;
  font-size: 24rpx;
  line-height: 1.48;
}

.summary-card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.summary-stat {
  min-height: 132rpx;
  padding: 20rpx 12rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(15, 118, 110, 0.1);
  text-align: center;
  box-sizing: border-box;
}

.summary-value {
  display: block;
  color: #0f766e;
  font-size: 42rpx;
  font-weight: 950;
  line-height: 1.1;
}

.summary-wrong {
  color: #be123c;
}

.summary-label {
  display: block;
  margin-top: 10rpx;
  color: #5f5a50;
  font-size: 21rpx;
  line-height: 1.35;
}

.tutor-button {
  width: 100%;
  margin-top: 24rpx !important;
}

.done-panel {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(240, 253, 250, 0.86);
}

.done-title {
  display: block;
  color: #0f766e;
  font-size: 28rpx;
  font-weight: 950;
}

.done-text {
  display: block;
  margin-top: 10rpx;
  color: #3f3a32;
  font-size: 24rpx;
  line-height: 1.6;
}
