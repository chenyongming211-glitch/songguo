<view class="page">
  <view class="hero-card settings-hero card">
    <text class="hero-label">服务连接</text>
    <text class="hero-title">服务连上后，就可以真机做题。</text>
    <text class="hero-subtitle">
      真机默认连接 HTTPS 生产 API。开发者工具里可以打开高级诊断临时切换本地地址。
    </text>
  </view>

  <view class="input-card card config-card service-card">
    <view class="section-header-line">
      <text class="section-title">当前服务</text>
      <text class="chip chip-accent">连接诊断</text>
    </view>
    <text class="service-label">{{serviceLabel}}</text>
    <text class="section-text">这里只测试学习服务是否可用，不需要孩子或家长理解底层模型状态。</text>
    <view class="button-row">
      <button class="button-primary" bindtap="handleTest" loading="{{testing}}">测试连接</button>
    </view>
    <text wx:if="{{lastChecked}}" class="tiny-note">最近测试：{{lastChecked}}</text>
  </view>

  <view wx:if="{{error}}" class="error-card">{{error}}</view>

  <view wx:if="{{diagnosticsAvailable}}" class="input-card card config-card">
    <view class="section-header-line">
      <text class="section-title">高级诊断</text>
      <button class="button-subtle advanced-toggle" bindtap="handleToggleAdvancedDiagnostics">
        {{advancedDiagnosticsVisible ? "收起" : "展开"}}
      </button>
    </view>
    <text class="section-text">调试后端地址、微信登录模式和模型链路状态。普通使用时不用打开。</text>

    <view wx:if="{{advancedDiagnosticsVisible}}" class="advanced-panel">
      <view class="connection-path">
        <text class="path-node">小程序</text>
        <view class="path-line"></view>
        <text class="path-node path-node-active">BFF</text>
        <view class="path-line"></view>
        <text class="path-node">AI引擎</text>
      </view>

      <view class="advanced-field">
        <view class="section-header-line">
          <text class="section-title">后端地址</text>
          <text class="chip">开发版</text>
        </view>
        <text class="section-text">用于 REST 请求，例如 /api/v1/learning/session 和 /api/v1/system/status。</text>
        <input
          class="text-input"
          value="{{httpBaseUrl}}"
          bindinput="handleHttpInput"
          placeholder="https://api.songguoxue.com"
        />
      </view>

      <text class="section-text">微信模式：{{wechatMode}}</text>
      <view class="button-row">
        <button class="button-secondary" bindtap="handleSave">保存配置</button>
        <button class="button-subtle" bindtap="handleReset">恢复默认值</button>
      </view>

      <view wx:if="{{status}}" class="status-grid">
        <view class="status-item card">
          <view class="status-badge"></view>
          <text class="status-label">Backend</text>
          <text class="status-value">{{status.backend.status}}</text>
        </view>
        <view class="status-item card">
          <view class="status-badge"></view>
          <text class="status-label">LLM</text>
          <text class="status-value">{{status.llm.status}} · {{status.llm.model}}</text>
        </view>
        <view class="status-item card">
          <view class="status-badge"></view>
          <text class="status-label">Embeddings</text>
          <text class="status-value">
            {{status.embeddings.status}} · {{status.embeddings.model}}
          </text>
        </view>
        <view class="status-item card">
          <view class="status-badge"></view>
          <text class="status-label">Search</text>
          <text class="status-value">{{status.search.status}} · {{status.search.provider}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
