.settings-hero {
  padding-bottom: 32rpx;
}

.connection-path {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding: 20rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.68);
  border: 1rpx solid rgba(15, 118, 110, 0.12);
}

.path-node {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(241, 245, 249, 0.9);
  color: #64748b;
  font-size: 26rpx;
  font-weight: 900;
}

.path-node-active {
  background: #0f766e;
  color: #ffffff;
}

.path-line {
  flex: 1;
  height: 4rpx;
  margin: 0 10rpx;
  border-radius: 999rpx;
  background: rgba(15, 118, 110, 0.2);
}

.config-card {
  overflow: hidden;
}

.section-header-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.config-card .button-row {
  display: grid;
  grid-template-columns: 1fr;
}

.service-card .button-row {
  margin-top: 20rpx;
}

.service-label {
  display: block;
  margin-top: 12rpx;
  color: #0f766e;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.35;
}

.advanced-toggle {
  margin: 0 !important;
  min-width: 150rpx;
}

.advanced-panel {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(148, 163, 184, 0.18);
}

.advanced-field {
  margin-top: 20rpx;
}

.status-grid {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.status-item {
  position: relative;
  padding-left: 58rpx;
}

.status-badge {
  position: absolute;
  left: 24rpx;
  top: 30rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: #0f766e;
  box-shadow: 0 0 0 8rpx rgba(15, 118, 110, 0.12);
}
