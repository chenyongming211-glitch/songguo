.home-hero {
  padding-bottom: 32rpx;
}

.hero-copy {
  position: relative;
  z-index: 2;
}

.entry-panel {
  margin-top: 24rpx;
}

.entry-primary {
  width: 100%;
  margin: 0 !important;
}

.entry-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 16rpx;
}

.entry-button {
  min-height: 90rpx;
  margin: 0 !important;
  padding: 0 18rpx !important;
  border-radius: 22rpx !important;
  background: rgba(255, 255, 255, 0.72) !important;
  color: #134e4a !important;
  font-size: 30rpx !important;
  font-weight: 900 !important;
  line-height: 90rpx !important;
  border: 1rpx solid rgba(15, 118, 110, 0.12) !important;
}

.learner-pill-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 20rpx;
  padding: 12rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.66);
  border: 1rpx solid rgba(15, 118, 110, 0.1);
}

.learner-pill {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 9rpx;
  min-width: 0;
}

.learner-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: #0f766e;
  box-shadow: 0 0 0 6rpx rgba(15, 118, 110, 0.11);
}

.learner-pill-text {
  color: #134e4a;
  font-size: 27rpx;
  font-weight: 900;
  white-space: nowrap;
}

.learner-pill-meta {
  padding: 5rpx 9rpx;
  border-radius: 999rpx;
  background: rgba(240, 253, 250, 0.94);
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 850;
  white-space: nowrap;
}

.child-switcher-inline {
  flex: 1;
  min-width: 120rpx;
  white-space: nowrap;
  text-align: right;
}

.child-chip {
  margin: 0 !important;
  border: 0 !important;
  line-height: 1.2 !important;
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
}

.child-chip {
  min-width: auto;
  margin-left: 10rpx !important;
  padding: 9rpx 16rpx !important;
  border-radius: 999rpx !important;
  background: rgba(241, 245, 249, 0.9) !important;
  color: #475569 !important;
  font-size: 26rpx !important;
  font-weight: 850 !important;
}

.child-chip-active {
  background: linear-gradient(135deg, #0f766e 0%, #134e4a 100%) !important;
  color: #ffffff !important;
  box-shadow: 0 14rpx 30rpx rgba(15, 118, 110, 0.18) !important;
}

.section-heading {
  margin: 4rpx 0 18rpx;
}

.session-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.session-card {
  position: relative;
  overflow: hidden;
  padding: 30rpx;
}

.session-glow {
  position: absolute;
  right: -50rpx;
  top: -60rpx;
  width: 160rpx;
  height: 160rpx;
  border-radius: 999rpx;
  background: rgba(20, 184, 166, 0.08);
}

.session-header {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.session-heading {
  flex: 1;
}

.session-title {
  display: block;
  color: #1c1917;
  font-size: 33rpx;
  font-weight: 900;
  line-height: 1.35;
}

.session-meta {
  display: block;
  margin-top: 10rpx;
  color: #7a7368;
  font-size: 26rpx;
}

.session-action {
  margin: 0 !important;
}

.session-tags {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.session-preview {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 18rpx;
  color: #3f3a32;
  font-size: 30rpx;
  line-height: 1.62;
}
